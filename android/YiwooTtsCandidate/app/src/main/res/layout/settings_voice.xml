<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView style="@style/SettingsSectionTitle" android:text="음성" />
    <LinearLayout style="@style/SettingsCard">
        <TextView style="@style/SettingsRowTitle" android:text="음성 언어" />
        <TextView android:id="@+id/engine_status" style="@style/SettingsSummary" android:text="엔진 상태: 준비 중" />
        <RadioGroup android:id="@+id/voice_language_group" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/language_korean" style="@style/SettingsRadio" android:text="한국어" />
            <TextView android:id="@+id/language_korean_hint" style="@style/SettingsSummary" android:text="사용 가능" />
            <RadioButton android:id="@+id/language_english" style="@style/SettingsRadio" android:text="영어" android:enabled="false" />
            <TextView android:id="@+id/language_english_hint" style="@style/SettingsSummary" android:text="준비 중" />
        </RadioGroup>
        <TextView android:id="@+id/language_mode_status" style="@style/SettingsSummary" android:text="사용자 선택" />
        <TextView android:id="@+id/use_system_language" style="@style/SettingsAction" android:text="시스템 언어에 따라 자동 선택" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp">
            <TextView style="@style/SettingsRowTitle" android:text="음성 데이터" />
            <TextView style="@style/SettingsRowTitle" android:text="한국어" android:layout_marginTop="8dp" />
            <TextView style="@style/SettingsSummary" android:text="내장됨 · YIWOO 한국어 음성" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
